generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
} // <--- The bracket belongs here, enclosing everything!






model User {
  id                String    @id @default(uuid())
  clerkId           String    @unique
  email             String
  downloadCount     Int       @default(0)
  lastDownloadReset DateTime  @default(now())
  appsumoCode       String?
  createdAt         DateTime  @default(now())

  @@map("users")
}

model Book {
  id        String    @id @default(uuid())
  userId    String
  title     String
  subtitle  String?   @default("An AI Generated Journey")
  content   String
  chapters  Chapter[] 
  createdAt DateTime  @default(now())

  @@map("books")
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  content   String
  order     Int      
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("chapters")
}

model CoverProject {
  id        String   @id @default(uuid())
  userId    String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cover_projects")
}

// A read-only review link for a cover design, shared with a client or
// co-author who may not have an account. Stores a flattened preview image
// rather than the editable design so the link can't be used to lift the
// original project, and so the public page needs no canvas library.
model CoverShare {
  id         String    @id @default(uuid())
  token      String    @unique
  userId     String
  title      String    @default("Untitled Cover")
  previewUrl String    // data: URL of the rendered cover preview
  trimLabel  String?
  pageCount  Int?
  spineWidth Float?
  revoked    Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("cover_shares")
}

model AppSumoRedemption {
  id        String   @id @default(uuid())
  clerkId   String
  email     String
  code      String   @unique
  createdAt DateTime @default(now())

  @@map("appsumo_redemptions")
}

model AppSumoValidCode {
  id         String    @id @default(uuid())
  code       String    @unique
  isRedeemed Boolean   @default(false)
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?

  @@map("appsumo_valid_codes")
}