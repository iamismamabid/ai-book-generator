generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
} // <--- The bracket belongs here, enclosing everything!






model User {
  id                String    @id @default(uuid())
  clerkId           String    @unique
  email             String
  downloadCount     Int       @default(0)
  lastDownloadReset DateTime  @default(now())
  appsumoCode       String?
  createdAt         DateTime  @default(now())

  @@map("users")
}

model Book {
  id        String    @id @default(uuid())
  userId    String
  title     String
  content   String
  chapters  Chapter[] 
  createdAt DateTime  @default(now())

  @@map("books")
}

model Chapter {
  id        String   @id @default(uuid())
  title     String
  content   String
  order     Int      
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("chapters")
}

model AppSumoRedemption {
  id        String   @id @default(uuid())
  clerkId   String
  email     String
  code      String   @unique
  createdAt DateTime @default(now())

  @@map("appsumo_redemptions")
}

model AppSumoValidCode {
  id         String    @id @default(uuid())
  code       String    @unique
  isRedeemed Boolean   @default(false)
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?

  @@map("appsumo_valid_codes")
}